{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {"type": "command", "command": "python3 -I \"/path/to/foreman/adapters/hook.py\" codex || exit 1", "timeout": 30}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3 -I \"/path/to/foreman/adapters/hook.py\" codex || exit 1", "timeout": 600}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 -I \"/path/to/foreman/adapters/hook.py\" codex || exit 1", "timeout": 30}
        ]
      }
    ]
  }
}
